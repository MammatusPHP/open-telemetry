parameters:
	level: max
	paths:
		- ../../etc
		- ../../src
		- ../../tests
	ignoreErrors:
		-
			identifier: ergebnis.noParameterWithNullDefaultValue
			path: ../../src/OtlpHttpTransportFactory.php
		-
			identifier: ergebnis.noParameterWithNullableTypeDeclaration
			path: ../../src/OtlpHttpTransportFactory.php
		-
			identifier: ergebnis.noConstructorParameterWithDefaultValue
			path: ../../src/OtlpHttpTransportFactory.php
		-
			identifier: ergebnis.noConstructorParameterWithDefaultValue
			path: ../../src/StreamTransportFactory.php
		-
			identifier: ergebnis.noParameterWithNullDefaultValue
			path: ../../src/StreamTransportFactory.php
		-
			identifier: ergebnis.noParameterWithNullableTypeDeclaration
			path: ../../src/StreamTransportFactory.php
		-
			identifier: ergebnis.noParameterWithNullableTypeDeclaration
			path: ../../src/Composer/Item.php
		-
			identifier: missingType.iterableValue
			path: ../../src/PsrTransport.php
		-
			identifier: staticMethod.internal
			path: ../../tests/WithSpan/HooksTest.php
		-
			identifier: staticMethod.internal
			path: ../../tests/WithInMemoryTracer.php
		-
			message: '#.*blocks the event loop.*#'
			path: ../../tests/**
