{
  "name": "mammatus/open-telemetry",
  "description": "\ud83d\udd75\ufe0f Open Telemetry integration",
  "license": "MIT",
  "type": "composer-plugin",
  "require": {
    "php": "^8.4",
    "ext-filter": "^8.4",
    "ext-json": "^8.4",
    "ext-opentelemetry": "*",
    "composer-plugin-api": "^2.0.0",
    "ancarda/psr7-string-stream": "^1.3.1",
    "composer/composer": "^2.9.2",
    "mammatus/life-cycle-events": "^2.3",
    "open-telemetry/api": "^1.10.0",
    "open-telemetry/context": "^1.5.0",
    "open-telemetry/exporter-otlp": "^1.4.0",
    "open-telemetry/opentelemetry-auto-psr6": "^0.0.5 || ^0.0.6 || ^0.0.7",
    "open-telemetry/opentelemetry-auto-psr14": "^0.0.5 || ^0.0.6 || ^0.0.7",
    "open-telemetry/opentelemetry-auto-psr15": "^1.3",
    "open-telemetry/opentelemetry-auto-psr16": "^0.0.5 || ^0.0.6 || ^0.0.7",
    "open-telemetry/opentelemetry-auto-psr18": "^1.3",
    "open-telemetry/opentelemetry-auto-reactphp": "^0.3.0 || ^0.4.0 || ^0.5.0",
    "open-telemetry/opentelemetry-logger-monolog": "^1.3",
    "open-telemetry/sdk": "^1.15.0",
    "open-telemetry/sem-conv": "^1.38.0",
    "php-http/discovery": "^1.14",
    "psr/http-client": "^1.0",
    "psr/http-client-implementation": "^1.0",
    "psr/http-factory": "^1.1",
    "psr/http-factory-implementation": "^1.0",
    "psr/http-message": "^1.0.1 || ^2.0",
    "react-inspector/cache": "^0.1",
    "react-inspector/dns": "^0.1",
    "react-inspector/filesystem": "^0.1",
    "react-inspector/socket": "^0.1",
    "react/async": "^4.3",
    "react/event-loop": "^1.5",
    "react/filesystem": "^0.2@dev",
    "react/http": "^1.11",
    "react/promise-stream": "^1.7",
    "react/promise-timer": "^1.11",
    "react/stream": "^1.4",
    "roave/better-reflection": "^6.72",
    "wyrihaximus/broadcast-contracts": "^1.3",
    "wyrihaximus/generative-composer-plugin-tooling": "^1.8.4"
  },
  "require-dev": {
    "wyrihaximus/async-test-utilities": "^14.1.0",
    "wyrihaximus/makefiles": "^0.14.6"
  },
  "autoload": {
    "psr-4": {
      "Mammatus\\OpenTelemetry\\": "src"
    },
    "files": [
      "src/register.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Mammatus\\Tests\\OpenTelemetry\\": "tests"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "drupol/composer-packages": true,
      "ergebnis/composer-normalize": true,
      "icanhazstring/composer-unused": true,
      "infection/extension-installer": true,
      "mindplay/composer-locator": true,
      "php-http/discovery": false,
      "phpstan/extension-installer": true,
      "tbachert/spi": false,
      "wyrihaximus/broadcast": true,
      "wyrihaximus/generative-composer-plugin-tooling": true,
      "wyrihaximus/makefiles": true,
      "wyrihaximus/test-utilities": true
    },
    "platform": {
      "php": "8.4.13"
    },
    "sort-packages": true
  },
  "extra": {
    "class": "Mammatus\\OpenTelemetry\\Composer\\CodeGenerator",
    "wyrihaximus": {
      "broadcast": {
        "has-listeners": true
      },
      "generative-composer-plugin-tooling": {
        "cache": "etc/state/generative-composer-plugin-tooling.json"
      }
    }
  },
  "scripts": {
    "post-install-cmd": [
      "composer normalize || true",
      "make on-install-or-update || true"
    ],
    "post-update-cmd": [
      "make on-install-or-update || true"
    ],
    "pre-autoload-dump": [
      "Mammatus\\OpenTelemetry\\Composer\\CodeGenerator::registerWithSpans",
      "Mammatus\\OpenTelemetry\\Composer\\CodeGenerator::findMonkeysToPatch"
    ],
    "generate-config": [
      "Mammatus\\OpenTelemetry\\Composer\\CodeGenerator::registerWithSpans",
      "Mammatus\\OpenTelemetry\\Composer\\CodeGenerator::findMonkeysToPatch"
    ]
  }
}
